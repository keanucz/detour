# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend API
PORT=8000

# LLM Backend Configuration
# Choose one of the following options:

# Option 1: Ollama (default, local)
NEMOTRON_BASE_URL=http://ollama:11434/v1
NEMOTRON_MODEL=nemotron

# Option 2: vLLM (GPU server)
# NEMOTRON_BASE_URL=http://vllm:8000/v1
# NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4

# Option 3: Remote/OpenAI
# NEMOTRON_BASE_URL=https://api.openai.com/v1
# NEMOTRON_MODEL=gpt-4o-mini
# NEMOTRON_API_KEY=your-api-key-here

# Optional: API Key for remote services
NEMOTRON_API_KEY=
